# Configuración del servidor del grupo. Copiar a .env y llenar:  cp .env.example .env
# docker compose lee este archivo solo. Nunca se sube .env al repositorio.
# Las opcionales vacías toman el valor por defecto que va entre paréntesis (D10).

# --- Obligatorias -------------------------------------------------------------------

# Nombre de este servidor en el central, por ejemplo g3 (P01: por confirmar).
GRUPO=
# URL con la que el central llega a este servidor: la IP de esta máquina en la red de
# la sala y PUERTO_HOST, por ejemplo http://192.168.1.23:8000 (P12).
URL_PUBLICA=
# URL del servidor central del curso, por ejemplo http://10.0.0.5:9000 (P07).
URL_CENTRAL=

# --- Opcionales ---------------------------------------------------------------------

# Puerto de esta máquina donde se publica el servidor (8000).
PUERTO_HOST=
# Cada cuánto se consulta GET /health del central, en segundos (5).
HEARTBEAT_INTERVALO_S=
# Fallos seguidos de GET /health para marcar el central como caído (3).
HEARTBEAT_FALLOS_PARA_CAIDO=
# Cada cuánto se renueva el registro en el central, en segundos (30).
REGISTRO_INTERVALO_S=
# Primera espera de un reintento, en segundos; se duplica en cada intento (1).
BACKOFF_BASE_S=
# Espera máxima entre reintentos, en segundos (30).
BACKOFF_MAX_S=
# Timeout de cada llamada al central, en segundos (3).
HTTP_TIMEOUT_S=
# Mostrar también una línea por cada petición HTTP recibida: true o false (false).
LOG_ACCESOS=
